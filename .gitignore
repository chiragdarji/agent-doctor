# Dependencies
node_modules/

# Build output — dist/ is committed so the GitHub Action works without a build step
# Source maps are excluded to keep the repo lean
dist/*.map

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp

# Test output
coverage/
.vitest/

# Temp
tmp/
temp/

# Claude Code agent worktrees (temporary isolated workspaces)
.claude/worktrees/

# VS Code extension packaging artifacts
*.vsix
# But track the published VSIX for download convenience
!packages/vscode-agent-doctor/*.vsix

# Lock files — commit package-lock.json, not yarn/pnpm
yarn.lock
pnpm-lock.yaml
